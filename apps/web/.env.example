# Repository backend: HTTP (production default) talks to the real API.
# Set to `localStorage` for the dev-only offline mode (no backend needed).
VITE_REPO_VARIANT=http

# Optional: point the client directly at the backend instead of the Vite proxy.
# When unset, requests are same-origin `/api/*` and proxied to the backend.
# VITE_API_BASE_URL=http://localhost:8080

# Override the dev/preview proxy target (defaults to http://localhost:8080).
# VITE_API_PROXY_TARGET=http://localhost:8080
