{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignore": [
        ".dependency-cruiser.mobile.cjs"
      ]
    },
    "apps/web": {
      "entry": [
        "src/app/router/index.ts",
        "src/**/*.test.ts",
        "e2e/**/*.ts",
        "steiger.config.ts"
      ],
      "project": [
        "src/**/*.{ts,vue}",
        "src/**/*.css",
        "!src/**/*.test.ts",
        "!src/__tests__/helpers/**",
        "!src/**/*.d.ts"
      ],
      "ignoreIssues": {
        "src/shared/ui/**/index.ts": [
          "exports",
          "types"
        ]
      },
      "ignoreDependencies": [
        "tailwindcss"
      ]
    },
    "apps/mobile": {
      "entry": [
        ".maestro/_launch.js",
        ".maestro/_random.js"
      ],
      "ignore": [
        "plugins/with-dev-menu-fab.js"
      ],
      "ignoreDependencies": [
        "expo-system-ui"
      ],
      "ignoreIssues": {
        "src/shared/ui/**": [
          "exports",
          "types"
        ],
        "src/entities/*/model/use-*.ts": [
          "exports",
          "types"
        ]
      }
    },
    "packages/api": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "ignoreIssues": {
        "src/schema.ts": [
          "exports",
          "types"
        ]
      }
    },
    "packages/tokens": {
      "ignoreDependencies": [
        "tailwindcss"
      ]
    }
  }
}
